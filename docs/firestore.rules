rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Patient data is accessed through the authenticated Express API.
    // Firebase Admin SDK bypasses these rules, so backend authorization is mandatory.
    match /patients/{document=**} {
      allow read, write: if false;
    }
    match /encounters/{document=**} {
      allow read, write: if false;
    }
    match /mappingReviews/{document=**} {
      allow read, write: if false;
    }
    match /auditLogs/{document=**} {
      allow read, write: if false;
    }
    match /terminologyMappings/{document=**} {
      allow read, write: if false;
    }
    match /users/{document=**} {
      allow read, write: if false;
    }
    match /datasetMetadata/{document=**} {
      allow read, write: if false;
    }
  }
}
